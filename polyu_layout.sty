% PolyU Beamer visual layer (brand tab, title page, cards, paired images, page numbers)
% Load after: \usepackage[polyu,en]{collegeBeamer}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{polyu_layout}[2026/11/16 PolyU Beamer layout helpers]

\RequirePackage{tikz}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\usetikzlibrary{arrows.meta,positioning,calc,fit}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{framesubtitle}{fg=darkgray}

% --- Brand tab + frametitle band ---------------------------------------------
\makeatletter
\newcommand{\logotabw}{1.05cm}
\newcommand{\logotabh}{1.55cm}
\newcommand{\logoemblem}{0.84cm}
\newcommand{\titleleftskip}{1.18cm}
% Path to title-page hero (south-east, bottom-glued). Override in the preamble if needed.
\newcommand{\titleheropath}{gallery/title_hero.png}

\setbeamertemplate{headline}{%
  \begin{tikzpicture}[remember picture,overlay]
    \coordinate (LNW) at (current page.north west);
    \fill[maincolor] (LNW) rectangle ++(\logotabw,-\logotabh);
    \node[anchor=center, inner sep=0]
      at ([xshift=0.525cm,yshift=-0.73cm]LNW)
      {\includegraphics[width=\logoemblem,height=\logoemblem]{src/PolyU/emblem-only.png}};
  \end{tikzpicture}%
}

% Top-align frames without stretchable title→content glue
\define@key{beamerframe}{t}[true]{%
  \beamer@frametopskip=0pt\relax%
  \beamer@framebottomskip=0pt plus 1fill\relax%
  \beamer@frametopskipautobreak=0pt\relax%
  \beamer@framebottomskipautobreak=0pt plus 1fill\relax%
}
\define@key{beamerframe}{c}[true]{%
  \beamer@frametopskip=0pt plus 1fill\relax%
  \beamer@framebottomskip=0pt plus 1fill\relax%
  \beamer@frametopskipautobreak=0pt plus .5\paperheight\relax%
  \beamer@framebottomskipautobreak=0pt plus .5\paperheight\relax%
}

\setbeamertemplate{frametitle}{%
  \begin{beamercolorbox}[leftskip=\titleleftskip,ht=\logotabh,dp=0pt,sep=0pt]{frametitle}%
    \vbox to \logotabh{%
      \vfil
      \raggedright
      \usebeamerfont{frametitle}\insertframetitle\\[-0.08em]
      \usebeamerfont{framesubtitle}\insertframesubtitle
      \vfil
    }%
  \end{beamercolorbox}%
  \vspace{0.40em}%
  \usebeamercolor[fg]{normal text}\color{black}%
}

% White title page; figure flush to bottom-right
\setbeamertemplate{title page}{}%
\renewcommand{\maketitle}{%
  \begingroup
    \setbeamertemplate{footline}{}%
    \setbeamertemplate{background}{}%
    \begin{frame}
      \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=north west, inner sep=0, text width=0.68\paperwidth, align=left]
          at ([xshift=1.95cm,yshift=-1.60cm]current page.north west)
          {%
            {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}\\[14pt]
            {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\[2pt]
            {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}%
          };
        % Same visual scale as original full-bleed bg (building ≈0.68 of slide height)
        \node[anchor=south east, inner sep=0pt]
          at (current page.south east)
          {\includegraphics[height=0.68\paperheight,keepaspectratio]{\titleheropath}};
      \end{tikzpicture}%
    \end{frame}%
  \endgroup
}

% Slide numbers on content frames only (title / TOC / Q&A clear footline)
\setbeamertemplate{footline}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south east, inner sep=0pt, font=\scriptsize, text=black!55]
      at ([xshift=-0.42cm,yshift=0.28cm]current page.south east)
      {\insertframenumber};
  \end{tikzpicture}%
}
\makeatother

% --- Height-matched image pairs ----------------------------------------------
\newsavebox{\studyleftbox}
\newlength{\studyleftht}
% \studypairxy{leftw}{imgw}{left}{image}
\newcommand{\studypairxy}[4]{%
  \begin{lrbox}{\studyleftbox}%
    \begin{minipage}[t]{#1}#3\end{minipage}%
  \end{lrbox}%
  \setlength{\studyleftht}{\dimexpr\ht\studyleftbox+\dp\studyleftbox\relax}%
  \noindent\usebox{\studyleftbox}\hfill
  \raisebox{-\dp\studyleftbox}{%
    \includegraphics[width=#2,height=\studyleftht,keepaspectratio=false]{#4}}%
}
\newcommand{\studypair}[2]{\studypairxy{0.55\textwidth}{0.42\textwidth}{#1}{#2}}
% Smaller image, vertically centered beside left stack
\newcommand{\studypairsm}[4]{%
  \begin{lrbox}{\studyleftbox}%
    \begin{minipage}[t]{#1}#3\end{minipage}%
  \end{lrbox}%
  \setlength{\studyleftht}{\dimexpr\ht\studyleftbox+\dp\studyleftbox\relax}%
  \noindent\usebox{\studyleftbox}\hfill
  \begin{minipage}[t][\studyleftht][c]{#2}
    \centering
    \includegraphics[width=\linewidth,keepaspectratio]{#4}%
  \end{minipage}%
}

% --- Cards -------------------------------------------------------------------
\newcommand{\drawcard}[3]{%
  \begin{tikzpicture}[baseline=(frame.north)]
    \node[anchor=north west, text width=\dimexpr#3-10pt\relax, align=center,
      font=\bfseries\small\sffamily, inner xsep=5pt, inner ysep=4pt] (T) at (0,0) {#1};
    \node[anchor=north west, text width=\dimexpr#3-10pt\relax, align=left,
      font=\scriptsize, inner xsep=5pt, inner ysep=5pt] (B) at (0,0|-T.south) {#2};
    \fill[white, rounded corners=5pt] (0,0) rectangle (#3,0|-B.south);
    \begin{scope}
      \clip (-1pt,1pt) rectangle (#3+1pt,0|-T.south);
      \fill[maincolor, rounded corners=5pt] (0,0) rectangle (#3,0|-B.south);
    \end{scope}
    \node[anchor=north west, text width=\dimexpr#3-10pt\relax, align=center,
      font=\bfseries\small\sffamily, text=white, inner xsep=5pt, inner ysep=4pt]
      at (0,0) {#1};
    \node[anchor=north west, text width=\dimexpr#3-10pt\relax, align=left,
      font=\scriptsize, text=black, inner xsep=5pt, inner ysep=5pt]
      at (0,0|-T.south) {#2};
    \draw[maincolor, line width=0.9pt, rounded corners=5pt]
      (0,0) rectangle (#3,0|-B.south);
    \draw[maincolor, line width=0.55pt]
      (1.2pt,0|-T.south) -- (#3-1.2pt,0|-T.south);
    \node[fit={(0,0) (#3,0|-B.south)}, inner sep=0] (frame) {};
  \end{tikzpicture}%
}

\newlength{\drawcardswidth}
\newcommand{\drawcards}[3]{%
  \setlength{\drawcardswidth}{#3}%
  \begin{tikzpicture}[baseline=(frame.north)]
    \node[anchor=north west, text width=\dimexpr\drawcardswidth-8pt\relax, align=center,
      font=\bfseries\small\sffamily, inner xsep=4pt, inner ysep=3pt] (T) at (0,0) {#1};
    \node[anchor=north west, text width=\dimexpr\drawcardswidth-8pt\relax, align=left,
      font=\small, inner xsep=4pt, inner ysep=3.5pt]
      (B) at (0,0|-T.south) {#2};
    \fill[white, rounded corners=4pt]
      (0,0) rectangle (\drawcardswidth,0|-B.south);
    \begin{scope}
      \clip (-1pt,1pt) rectangle (\drawcardswidth+1pt,0|-T.south);
      \fill[maincolor, rounded corners=4pt]
        (0,0) rectangle (\drawcardswidth,0|-B.south);
    \end{scope}
    \node[anchor=north west, text width=\dimexpr\drawcardswidth-8pt\relax, align=center,
      font=\bfseries\small\sffamily, text=white, inner xsep=4pt, inner ysep=3pt]
      at (0,0) {#1};
    \node[anchor=north west, text width=\dimexpr\drawcardswidth-8pt\relax, align=left,
      font=\small, text=black, inner xsep=4pt, inner ysep=3.5pt]
      at (0,0|-T.south) {#2};
    \draw[maincolor, line width=0.8pt, rounded corners=4pt]
      (0,0) rectangle (\drawcardswidth,0|-B.south);
    \draw[maincolor, line width=0.5pt]
      (1pt,0|-T.south) -- (\drawcardswidth-1pt,0|-T.south);
    \node[fit={(0,0) (\drawcardswidth,0|-B.south)}, inner sep=0] (frame) {};
  \end{tikzpicture}%
}

% Truly centered statement (H+V): page-center overlay (slight optical drop for brand tab)
\renewcommand{\centerstate}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=center, align=center, text width=0.82\paperwidth,
      font=\normalsize, inner sep=0pt]
      at ([yshift=-0.35cm]current page.center) {#1};
  \end{tikzpicture}%
}

% Tables: Beamer structure color turns rules/text maroon unless forced black
\newcommand{\plaintable}[1]{%
  \begingroup
    \color{black}%
    \arrayrulecolor{black}%
    #1%
  \endgroup
}

% Q&A centered even with documentclass[t]
\renewcommand{\QApage}{%
  \begingroup
    \setbeamertemplate{footline}{}%
    \themecolor{colorbg}%
    \begin{frame}[c]
      \centering
      \begin{minipage}{\textwidth}
        \usebeamercolor[fg]{normal text}%
        \centering
        \Huge $$\mathcal Q \& \mathcal A$$
        \Large \qaStr
      \end{minipage}
    \end{frame}
  \endgroup
}
